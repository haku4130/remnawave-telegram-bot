# Имя ноды в точности как в панели Remnawave: MSK-1, MSK-2, MSK-4, NL-1, SE-1
NODE_NAME=MSK-4

# Адрес кабинета, без завершающего слэша
CABINET_URL=https://cabinet.zanity.net

# Общий секрет счётчика: им подписывается заголовок X-Location-Counter-Token
# и солятся хеши пользователей и устройств. Должен совпадать с настройкой кабинета.
LOCATION_COUNTER_TOKEN=change-me
